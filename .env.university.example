# Copy to .env.university and fill in. Never commit the filled file.
NODE_NAME=my-university-node
PUBLIC_SITE_URL=http://localhost:3000
# A long random string, e.g. `openssl rand -hex 32`. Admin routes return 503 while empty.
ADMIN_SECRET=
PUBLISH_RATE_LIMIT=3
MIN_PAPER_WORDS=500
MIN_DRAFT_WORDS=150
# Judges: fill only what you have. More independent judges = more reliable scores.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
# Optional durable tiers
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GITHUB_PAPERS_SYNC_TOKEN=
GITHUB_PAPERS_REPO_OWNER=
GITHUB_PAPERS_REPO_NAME=
